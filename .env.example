# ─────────────────────────────────────────────────────────────
# Axtara website — environment variables (copy to .env.local)
# Never commit real values. Server-only secrets must NOT be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.axtara.com
# Set to "false" on preview deployments to block indexing
ALLOW_INDEXING=true

# Product claims mode: "strict" (default in production) shows unverified capabilities
# as "Confirm in demo"; "preview" hides those badges for internal review.
NEXT_PUBLIC_CLAIMS_MODE=

# Show draft resources articles (default: on in development only)
CONTENT_PREVIEW=false
# Show photography art-direction briefs on placeholder images in production
NEXT_PUBLIC_SHOW_MEDIA_BRIEFS=false

# ── Application links ──
NEXT_PUBLIC_APP_LOGIN_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# ── Public contact addresses (shown only when set) ──
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=

# ── Form delivery (server-only). Configure at least one, or forms return 503. ──
# CRM / automation webhook — receives JSON; signed with HMAC-SHA256 when a secret is set
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
# Email delivery via Resend REST API
RESEND_API_KEY=
FORMS_EMAIL_TO=
FORMS_EMAIL_FROM=

# ── Pricing (server-only). Rates are never committed. ──
# JSON array of rate cards (see config/pricing/rates.example.json). Only cards with
# "approved": true are sent to browsers.
PRICING_RATES_JSON=
# Internal preview deployments only — shows unapproved rate cards. Ignored on production.
PRICING_PREVIEW=false

# ── Analytics (optional, privacy-conscious; off unless configured) ──
# none | plausible | custom
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Require consent before analytics loads (recommended: true)
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
